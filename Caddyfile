{
	email {env.CADDY_DNS_EMAIL}
	acme_dns cloudflare {env.CF_AUTH_TOKEN}

	log {
		level WARN
	}
}

{$NETDATA_SUBDOMAIN}.{$CADDY_DOMAIN} {
	encode zstd gzip

	reverse_proxy host.docker.internal:19999
}

{$DOH_SUBDOMAIN}.{$CADDY_DOMAIN} {
	reverse_proxy /dns-query blocky:4000 {
		# Blocky trusts Forwarded over X-Forwarded-For; drop the client's copy
		# so it can't spoof its IP to escape its client group's blocklists
		header_up -Forwarded
	}
}

http://localhost:80 {
	respond /caddy-health-check 200
}
